{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orb-lancers",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // Shared game code is imported via this alias (no package linking needed).
  "alias": { "@orb/shared": "./shared/src/index.ts" },

  // The built Phaser client is served by the same Worker (free static assets).
  // API routes always reach the Worker first.
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRoom" }]
  },
  // SQLite-backed Durable Objects are required on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  // Production defaults. Local overrides live in .dev.vars (see .dev.vars.example).
  "vars": {
    "ENVIRONMENT": "production",
    // Comma-separated origins allowed to use the API (your Lovable / custom domains), or "*".
    "ALLOWED_ORIGINS": "*",
    "LOG_LEVEL": "info"
  }
}
